@page "/apitesting"
@page "/apitesting/resource/{resourceName}"

@using Aspire.Dashboard.Model
@using Aspire.Dashboard.Model.Otlp
@using Aspire.Dashboard.Resources
@using Aspire.Dashboard.Utils
@using System.Text.Json
@using Aspire.Dashboard.Components.Controls.Grid

@inject IJSRuntime JS

@implements IDisposable

<PageTitle>
    <ApplicationName
        AdditionalText="@PageViewModel.SelectedResource.Id?.ReplicaSetName"
        ResourceName="@nameof(Dashboard.Resources.ApiTesting.ApiTestingPageTitle)"
        Loc="@Loc"/>
</PageTitle>

<div class="page-content-container">
    <AspirePageContentLayout AddNewlineOnToolbar="true" @ref="@_contentLayout">
        <PageTitleSection>
            <h1 class="page-header">@Loc[nameof(Dashboard.Resources.ApiTesting.ApiTestingHeader)]</h1>
        </PageTitleSection>
        <ToolbarSection>
            <ResourceSelect Resources="_resourceViewModels"
                            AriaLabel="@ControlsStringsLoc[nameof(ControlsStrings.SelectAResource)]"
                            @bind-SelectedResource="PageViewModel.SelectedResource"
                            @bind-SelectedResource:after="HandleSelectedResourceChanged"
                            CanSelectGrouping="false"
                            LabelClass="toolbar-left" />
        </ToolbarSection>
        <MainSection>
            @if (PageViewModel.SelectedResource.Id is not null)
            {
                <div class="api-testing-container">
                    <div class="api-sidebar">
                        <FluentTabs Orientation="Orientation.Vertical">
                            <FluentTab Label="@Loc[nameof(Dashboard.Resources.ApiTesting.ApiTestingEndpoints)]">
                                <div class="sidebar-content">
                                    @if (_discoveredEndpoints.Any())
                                    {
                                        <p style="color: green; font-weight: bold;">Found @_discoveredEndpoints.Count endpoints</p>
                                        @foreach (var endpoint in _discoveredEndpoints)
                                        {
                                            <div class="endpoint-item">
                                                <div class="endpoint-header">
                                                    <span class="endpoint-method method-@endpoint.Method.ToLowerInvariant()">@endpoint.Method</span>
                                                    <span class="endpoint-path">@endpoint.Path</span>
                                                </div>
                                                @if (!string.IsNullOrEmpty(endpoint.Summary))
                                                {
                                                    <div class="endpoint-summary">@endpoint.Summary</div>
                                                }
                                                <FluentButton Appearance="Appearance.Lightweight" OnClick="async () => await LoadEndpoint(endpoint)">
                                                    @Loc[nameof(Dashboard.Resources.ApiTesting.ApiTestingLoadEndpoint)]
                                                </FluentButton>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <p style="color: orange; font-weight: bold;">No OpenAPI endpoints discovered (count: @_discoveredEndpoints.Count)</p>
                                        <p style="color: gray; font-size: 0.9em;">Check browser console and server logs for details</p>
                                    }
                                </div>
                            </FluentTab>
                            <FluentTab Label="@Loc[nameof(Dashboard.Resources.ApiTesting.ApiTestingHistory)]">
                                <div class="sidebar-content">
                                    @if (_history.Any())
                                    {
                                        <FluentButton Appearance="Appearance.Lightweight" OnClick="ClearHistoryAsync" Style="margin-bottom: 8px;">
                                            @Loc[nameof(Dashboard.Resources.ApiTesting.ApiTestingClearHistory)]
                                        </FluentButton>
                                        @foreach (var request in _history)
                                        {
                                            <div class="history-item" @onclick="() => LoadFromHistory(request)">
                                                <div><strong>@request.Method</strong> @request.Url</div>
                                                <div class="history-time">@request.LastUsedAt.ToString("g")</div>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <p>No request history</p>
                                    }
                                </div>
                            </FluentTab>
                            <FluentTab Label="@Loc[nameof(Dashboard.Resources.ApiTesting.ApiTestingFavorites)]">
                                <div class="sidebar-content">
                                    @if (_favorites.Any())
                                    {
                                        @foreach (var request in _favorites)
                                        {
                                            <div class="favorite-item">
                                                <div @onclick="() => LoadFromHistory(request)" style="cursor: pointer;">
                                                    <div><strong>@request.Name</strong></div>
                                                    <div class="favorite-url">@request.Method @request.Url</div>
                                                </div>
                                                <FluentButton Appearance="Appearance.Lightweight" OnClick="() => RemoveFromFavoritesAsync(request.Id)">
                                                    @Loc[nameof(Dashboard.Resources.ApiTesting.ApiTestingRemoveFromFavorites)]
                                                </FluentButton>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <p>No favorites</p>
                                    }
                                </div>
                            </FluentTab>
                            <FluentTab Label="@Loc[nameof(Dashboard.Resources.ApiTesting.ApiTestingEnvironmentVariables)]">
                                <div class="sidebar-content">
                                    <div class="env-var-info">
                                        <p>Use <code>{{`{variable}`}}</code> in URLs, headers, or body</p>
                                    </div>
                                    @if (_environmentVariables.Any())
                                    {
                                        @foreach (var variable in _environmentVariables)
                                        {
                                            <div class="env-var-item">
                                                <strong>@variable.Key:</strong> @(variable.IsSecret ? "****" : variable.Value)
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <p>No environment variables</p>
                                    }
                                </div>
                            </FluentTab>
                        </FluentTabs>
                    </div>
                    
                    <div class="api-request-section">
                        <div class="request-header">
                            <h3>@Loc[nameof(Dashboard.Resources.ApiTesting.ApiTestingRequestHeader)]</h3>
                            <div class="request-actions">
                                <FluentButton Appearance="Appearance.Lightweight" OnClick="AddToFavoritesAsync">
                                    <FluentIcon Value="@(new Icons.Regular.Size16.Star())" />
                                    @Loc[nameof(Dashboard.Resources.ApiTesting.ApiTestingAddToFavorites)]
                                </FluentButton>
                                <FluentButton Appearance="Appearance.Lightweight" OnClick="ExportAsCurlAsync">
                                    @Loc[nameof(Dashboard.Resources.ApiTesting.ApiTestingExportAsCurl)]
                                </FluentButton>
                                <FluentButton Appearance="Appearance.Lightweight" OnClick="ExportAsCSharpAsync">
                                    @Loc[nameof(Dashboard.Resources.ApiTesting.ApiTestingExportAsCSharp)]
                                </FluentButton>
                            </div>
                        </div>
                        
                        <div class="request-method-url">
                            <FluentSelect TOption="string" @bind-Value="_selectedMethod" Style="width: 120px;">
                                <FluentOption TOption="string" Value="GET">GET</FluentOption>
                                <FluentOption TOption="string" Value="POST">POST</FluentOption>
                                <FluentOption TOption="string" Value="PUT">PUT</FluentOption>
                                <FluentOption TOption="string" Value="DELETE">DELETE</FluentOption>
                                <FluentOption TOption="string" Value="PATCH">PATCH</FluentOption>
                            </FluentSelect>
                            
                            <FluentTextField @bind-Value="_requestUrl" 
                                            Placeholder="@Loc[nameof(Dashboard.Resources.ApiTesting.ApiTestingUrlPlaceholder)]"
                                            Style="flex: 1; margin-left: 8px; margin-right: 8px;"/>
                            
                            <FluentButton Appearance="Appearance.Accent" 
                                         OnClick="SendRequestAsync"
                                         Disabled="_isLoading">
                                @if (_isLoading)
                                {
                                    <FluentIcon Value="@(new Icons.Regular.Size20.ArrowSync())" />
                                }
                                else
                                {
                                    @Loc[nameof(Dashboard.Resources.ApiTesting.ApiTestingSendButton)]
                                }
                            </FluentButton>
                        </div>

                        <FluentTabs>
                            <FluentTab Label="@Loc[nameof(Dashboard.Resources.ApiTesting.ApiTestingHeadersTab)]">
                                <FluentTextArea @bind-Value="_requestHeaders" 
                                               Rows="5"
                                               Placeholder="@Loc[nameof(Dashboard.Resources.ApiTesting.ApiTestingHeadersPlaceholder)]"
                                               Style="width: 100%; margin-top: 8px;"/>
                            </FluentTab>
                            <FluentTab Label="@Loc[nameof(Dashboard.Resources.ApiTesting.ApiTestingBodyTab)]">
                                <FluentTextArea @bind-Value="_requestBody" 
                                               Rows="10"
                                               Placeholder="@Loc[nameof(Dashboard.Resources.ApiTesting.ApiTestingBodyPlaceholder)]"
                                               Style="width: 100%; margin-top: 8px;"/>
                            </FluentTab>
                        </FluentTabs>
                    </div>

                    @if (_responseInfo is not null)
                    {
                        <div class="api-response-section">
                            <h3>@Loc[nameof(Dashboard.Resources.ApiTesting.ApiTestingResponseHeader)]</h3>
                            
                            <div class="response-status">
                                <strong>@Loc[nameof(Dashboard.Resources.ApiTesting.ApiTestingStatus)]:</strong> 
                                <span class="@GetStatusClass(_responseInfo.StatusCode)">@_responseInfo.StatusCode @_responseInfo.StatusDescription</span>
                                <span style="margin-left: 16px;"><strong>@Loc[nameof(Dashboard.Resources.ApiTesting.ApiTestingTime)]:</strong> @_responseInfo.ElapsedMilliseconds ms</span>
                            </div>

                            @if (!string.IsNullOrEmpty(_responseInfo.TraceId))
                            {
                                <div class="response-trace">
                                    <strong>@Loc[nameof(Dashboard.Resources.ApiTesting.ApiTestingTraceId)]:</strong> 
                                    <FluentAnchor Href="@GetTraceUrl(_responseInfo.TraceId)" Appearance="Appearance.Hypertext">
                                        @OtlpHelpers.ToShortenedId(_responseInfo.TraceId)
                                    </FluentAnchor>
                                </div>
                            }

                            <FluentTabs>
                                <FluentTab Label="@Loc[nameof(Dashboard.Resources.ApiTesting.ApiTestingBodyTab)]">
                                    <pre class="response-body">@_responseInfo.Body</pre>
                                </FluentTab>
                                <FluentTab Label="@Loc[nameof(Dashboard.Resources.ApiTesting.ApiTestingHeadersTab)]">
                                    <pre class="response-headers">@_responseInfo.Headers</pre>
                                </FluentTab>
                            </FluentTabs>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <FluentIcon Value="@(new Icons.Regular.Size24.Code())" Style="font-size: 48px;"/>
                    <p>@Loc[nameof(Dashboard.Resources.ApiTesting.ApiTestingEmptyState)]</p>
                </div>
            }
        </MainSection>
    </AspirePageContentLayout>
</div>
